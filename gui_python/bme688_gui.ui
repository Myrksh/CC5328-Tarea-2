<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1100</width>
    <height>900</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Tarea 2 — Control BME688 &amp; Visualización</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout_main">
    <item>
     <widget class="QTabWidget" name="pestanas">
      <property name="currentIndex">
       <number>0</number>
      </property>
      
      <!-- PESTAÑA PRINCIPAL ÚNICA -->
      <widget class="QWidget" name="tab_panel_unico">
       <attribute name="title">
        <string>Panel de Control y Visualización</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_panel">
        
        <!-- BARRA SUPERIOR: BOTÓN PAUSA (50%) + FRECUENCIA (50%) -->
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_top_controls">
          <item stretch="1">
           <widget class="QPushButton" name="pausa_graficos">
            <property name="text">
             <string>Pausar Lecturas</string>
            </property>
           </widget>
          </item>
          <item stretch="1">
           <layout class="QHBoxLayout" name="horizontalLayout_freq_inline">
            <item>
             <widget class="QLabel" name="lbl_freq">
              <property name="text">
               <string>Frecuencia de Muestreo (Hz):</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignVCenter</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="combo_frecuencia">
              <property name="currentIndex">
               <number>1</number>
              </property>
              <item><property name="text"><string>0.5</string></property></item>
              <item><property name="text"><string>1</string></property></item>
              <item><property name="text"><string>2</string></property></item>
              <item><property name="text"><string>5</string></property></item>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </item>

        <!-- SECCIÓN DE GRÁFICOS Y CONTROLES (PROPORCIÓN EXACTA 2/3 Y 1/3) -->
        
        <!-- 1. TEMPERATURA -->
        <item stretch="2">
         <widget class="QGroupBox" name="group_temp">
          <property name="title">
           <string>Temperatura (°C)</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayout_temp_box">
           <!-- Layout del gráfico (Stretch 2 -> 2/3) -->
           <item stretch="2">
            <layout class="QVBoxLayout" name="plot_layout_temp"/>
           </item>
           <!-- Layout de controles y valor (Stretch 1 -> 1/3) -->
           <item stretch="1">
            <layout class="QVBoxLayout" name="verticalLayout_temp_ctrl">
             <item>
              <widget class="QCheckBox" name="chk_temp">
               <property name="text">
                <string>Transmitir Temp.</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_title_temp">
               <property name="text">
                <string>Valor Actual:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_val_temp">
               <property name="styleSheet">
                <string>font-size: 14pt; font-weight: bold;</string>
               </property>
               <property name="text">
                <string>-- °C</string>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="verticalSpacer_temp">
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 2. HUMEDAD RELATIVA -->
        <item stretch="2">
         <widget class="QGroupBox" name="group_hum">
          <property name="title">
           <string>Humedad Relativa (%HR)</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayout_hum_box">
           <!-- Layout del gráfico (Stretch 2 -> 2/3) -->
           <item stretch="2">
            <layout class="QVBoxLayout" name="plot_layout_hum"/>
           </item>
           <!-- Layout de controles y valor (Stretch 1 -> 1/3) -->
           <item stretch="1">
            <layout class="QVBoxLayout" name="verticalLayout_hum_ctrl">
             <item>
              <widget class="QCheckBox" name="chk_hum">
               <property name="text">
                <string>Transmitir Humedad</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_title_hum">
               <property name="text">
                <string>Valor Actual:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_val_hum">
               <property name="styleSheet">
                <string>font-size: 14pt; font-weight: bold;</string>
               </property>
               <property name="text">
                <string>-- %HR</string>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="verticalSpacer_hum">
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 3. PRESIÓN ATMOSFÉRICA -->
        <item stretch="2">
         <widget class="QGroupBox" name="group_pres">
          <property name="title">
           <string>Presión Atmosférica (hPa)</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayout_pres_box">
           <!-- Layout del gráfico (Stretch 2 -> 2/3) -->
           <item stretch="2">
            <layout class="QVBoxLayout" name="plot_layout_pres"/>
           </item>
           <!-- Layout de controles y valor (Stretch 1 -> 1/3) -->
           <item stretch="1">
            <layout class="QVBoxLayout" name="verticalLayout_pres_ctrl">
             <item>
              <widget class="QCheckBox" name="chk_pres">
               <property name="text">
                <string>Transmitir Presión</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_title_pres">
               <property name="text">
                <string>Valor Actual:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_val_pres">
               <property name="styleSheet">
                <string>font-size: 14pt; font-weight: bold;</string>
               </property>
               <property name="text">
                <string>-- hPa</string>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="verticalSpacer_pres">
               <property name="orientation">
                <enum>Qt::Vertical</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>20</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- SECCIÓN INFERIOR: PROMEDIO (IZQ) Y PICOS (DER) -->
        <item stretch="1">
         <layout class="QHBoxLayout" name="horizontalLayout_bottom_processing">
          
          <!-- RECUADRO IZQUIERDA: PROMEDIO MÓVIL ESP32 -->
          <item stretch="1">
           <widget class="QGroupBox" name="group_media_movil">
            <property name="title">
             <string>Promedio Móvil Embebido (ESP32)</string>
            </property>
            <layout class="QGridLayout" name="gridLayout_mm">
             <item row="0" column="0" colspan="2">
              <widget class="QCheckBox" name="chk_media_movil">
               <property name="text">
                <string>Habilitar Cálculo de Promedio</string>
               </property>
               <property name="checked">
                <bool>false</bool>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="lbl_w">
               <property name="text">
                <string>Ventana W (s):</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QComboBox" name="combo_ventana_w">
               <property name="currentIndex">
                <number>1</number>
               </property>
               <item><property name="text"><string>5</string></property></item>
               <item><property name="text"><string>10</string></property></item>
               <item><property name="text"><string>30</string></property></item>
               <item><property name="text"><string>60</string></property></item>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="lbl_title_avg">
               <property name="text">
                <string>temp_avg_c Recibido:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLabel" name="lbl_val_temp_avg">
               <property name="styleSheet">
                <string>font-weight: bold;</string>
               </property>
               <property name="text">
                <string>-- °C</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- RECUADRO DERECHA: DETECCIÓN DE PICOS ESP32 -->
          <item stretch="1">
           <widget class="QGroupBox" name="group_picos">
            <property name="title">
             <string>Detección de Picos Embebida (ESP32)</string>
            </property>
            <layout class="QGridLayout" name="gridLayout_picos">
             <item row="0" column="0" colspan="2">
              <widget class="QCheckBox" name="chk_picos">
               <property name="text">
                <string>Habilitar Detección de Picos</string>
               </property>
               <property name="checked">
                <bool>false</bool>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="lbl_umbral">
               <property name="text">
                <string>Umbral θ (°C):</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="spin_umbral_pico">
               <property name="singleStep">
                <double>0.100000000000000</double>
               </property>
               <property name="value">
                <double>28.000000000000000</double>
               </property>
              </widget>
             </item>
             <item row="2" column="0" colspan="2">
              <widget class="QListWidget" name="lista_eventos_picos">
               <property name="maximumHeight">
                <number>75</number>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

         </layout>
        </item>

       </layout>
      </widget>

      <!-- PESTAÑA 2: CONFIGURACIÓN PUERTO SERIAL (TAL CUAL) -->
      <widget class="QWidget" name="configuracion">
       <attribute name="title">
        <string>Configuración Puerto Serial</string>
       </attribute>
       <layout class="QGridLayout" name="gridLayout_serial">
        <item row="0" column="0">
         <widget class="QLabel" name="baudios_combo_label">
          <property name="text">
           <string>Baud Rate</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="baudios_combo">
          <item><property name="text"><string>115200</string></property></item>
          <item><property name="text"><string>230400</string></property></item>
          <item><property name="text"><string>460800</string></property></item>
          <item><property name="text"><string>921600</string></property></item>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="puerto_combo_label">
          <property name="text">
           <string>Puerto ESP-32</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
